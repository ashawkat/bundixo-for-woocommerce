{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "pickpack/bundle",
	"title": "PickPack Bundle",
	"category": "woocommerce",
	"description": "Display a PickPack bundle builder widget with tiered quantity discounts.",
	"keywords": [ "bundle", "pickpack", "woocommerce", "discount" ],
	"textdomain": "pickpack-for-woocommerce",
	"attributes": {
		"bundleId": {
			"type": "integer",
			"default": 0
		}
	},
	"supports": {
		"html": false,
		"customClassName": false,
		"multiple": true
	},
	"editorScript": "pickpack-block-editor",
	"editorStyle": "pickpack-frontend"
}
