{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "bundixo/bundle",
	"title": "Bundixo Bundle",
	"category": "woocommerce",
	"description": "Display a Bundixo bundle builder widget with tiered quantity discounts.",
	"keywords": [ "bundle", "bundixo", "woocommerce", "discount" ],
	"textdomain": "bundixo-for-woocommerce",
	"attributes": {
		"bundleId": {
			"type": "integer",
			"default": 0
		}
	},
	"supports": {
		"html": false,
		"customClassName": false,
		"multiple": true
	},
	"editorScript": "bundixo-block-editor",
	"editorStyle": "bundixo-frontend"
}
